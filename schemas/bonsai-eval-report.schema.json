{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openphone.example/contracts/bonsai-eval-report.schema.json",
  "title": "OpenPhone Bonsai Evaluation Report",
  "type": "object",
  "required": ["schema", "suite_id", "runtime", "summary", "cases", "telemetry"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "openphone.bonsai_eval_report.v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "required": ["runtime_commit", "model_sha256", "mmproj_sha256", "backend", "cloud"],
      "additionalProperties": false,
      "properties": {
        "runtime_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mmproj_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "backend": {"type": "string", "enum": ["cpu_neon_kleidiai", "vulkan"]},
        "cloud": {"type": "boolean", "const": false}
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "accuracy", "warm_first_token_p50_millis", "warm_first_token_p95_millis", "warm_decode_p50_tokens_per_second", "cancel_p95_millis"],
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "warm_first_token_p50_millis": {"type": "integer", "minimum": 1},
        "warm_first_token_p95_millis": {"type": "integer", "minimum": 1},
        "warm_decode_p50_tokens_per_second": {"type": "number", "exclusiveMinimum": 0},
        "cancel_p95_millis": {"type": "integer", "minimum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "passed"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "enum": ["text", "reasoning", "vision", "cancellation", "tool_safety"]},
          "passed": {"type": "boolean"}
        }
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["peak_rss_bytes", "battery_drain_percent", "thermal_severe", "low_memory_kill", "non_loopback_listener"],
      "additionalProperties": false,
      "properties": {
        "peak_rss_bytes": {"type": "integer", "minimum": 1},
        "battery_drain_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "thermal_severe": {"type": "boolean"},
        "low_memory_kill": {"type": "boolean"},
        "non_loopback_listener": {"type": "boolean"}
      }
    }
  }
}
